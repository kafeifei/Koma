{
  "name": "@koma/desktop",
  "private": true,
  "version": "0.1.0-beta.1",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/kafeifei/Koma",
  "author": {
    "name": "kafeifei"
  },
  "scripts": {
    "typecheck": "tsgo -b",
    "predev": "OPENCODE_CHANNEL=lab bun ./scripts/prebuild.ts",
    "dev": "OPENCODE_CHANNEL=lab electron-vite dev",
    "prebuild": "bun ./scripts/prebuild.ts",
    "build:lab-cli": "bun run build:koma-cli",
    "install:lab-cli": "bun run install:koma-cli",
    "build": "electron-vite build",
    "build:lab": "bun run build:debug",
    "preview": "electron-vite preview",
    "package": "electron-builder --config electron-builder.config.ts",
    "package:lab": "bun run package:debug",
    "lab": "bun run debug",
    "package:mac": "electron-builder --mac --config electron-builder.config.ts",
    "package:win": "electron-builder --win --config electron-builder.config.ts",
    "package:linux": "electron-builder --linux --config electron-builder.config.ts",
    "native:build": "bun install --cwd native",
    "release:mac": "KOMA_RELEASE=1 bun ./scripts/build-koma.ts --package",
    "package:release": "OPENCODE_CHANNEL=lab electron-builder --mac zip --publish never --config electron-builder.config.ts",
    "build:debug": "bun ./scripts/build-koma.ts",
    "debug": "bun ./scripts/build-koma.ts --package",
    "build:koma-cli": "bun ./scripts/build-koma-cli.ts",
    "install:koma-cli": "bun ./scripts/install-koma-cli.ts",
    "package:debug": "OPENCODE_CHANNEL=lab electron-builder --mac dir --config electron-builder.config.ts"
  },
  "main": "./out/main/index.js",
  "dependencies": {
    "@microsoft/dev-tunnels-connections": "1.3.56",
    "@microsoft/dev-tunnels-contracts": "1.3.56",
    "@microsoft/dev-tunnels-management": "1.3.56",
    "@microsoft/dev-tunnels-ssh": "3.12.42",
    "@microsoft/dev-tunnels-ssh-tcp": "3.12.42",
    "@opencode-ai/remote": "workspace:*",
    "@zip.js/zip.js": "2.7.62",
    "effect": "catalog:",
    "electron-context-menu": "4.1.2",
    "electron-log": "^5",
    "electron-store": "11.0.2",
    "electron-updater": "6.8.9",
    "electron-window-state": "^5.0.3",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@opencode-ai/core": "workspace:*",
    "@actions/artifact": "4.0.0",
    "@lydell/node-pty": "catalog:",
    "@opencode-ai/app": "workspace:*",
    "@opencode-ai/ui": "workspace:*",
    "@sentry/solid": "catalog:",
    "@sentry/vite-plugin": "catalog:",
    "@solid-primitives/i18n": "2.2.1",
    "@solid-primitives/storage": "catalog:",
    "@solidjs/meta": "catalog:",
    "@solidjs/router": "0.15.4",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "@valibot/to-json-schema": "1.6.0",
    "electron": "42.3.3",
    "electron-builder": "26.15.2",
    "electron-vite": "^5",
    "solid-js": "catalog:",
    "sury": "11.0.0-alpha.4",
    "typescript": "~5.6.2",
    "vite": "catalog:",
    "zod-openapi": "5.4.6"
  },
  "optionalDependencies": {
    "@lydell/node-pty-darwin-arm64": "1.2.0-beta.12",
    "@lydell/node-pty-darwin-x64": "1.2.0-beta.12",
    "@lydell/node-pty-linux-arm64": "1.2.0-beta.12",
    "@lydell/node-pty-linux-x64": "1.2.0-beta.12",
    "@lydell/node-pty-win32-arm64": "1.2.0-beta.12",
    "@lydell/node-pty-win32-x64": "1.2.0-beta.12",
    "@parcel/watcher-darwin-arm64": "2.5.1",
    "@parcel/watcher-darwin-x64": "2.5.1",
    "@parcel/watcher-linux-arm64-glibc": "2.5.1",
    "@parcel/watcher-linux-arm64-musl": "2.5.1",
    "@parcel/watcher-linux-x64-glibc": "2.5.1",
    "@parcel/watcher-linux-x64-musl": "2.5.1",
    "@parcel/watcher-win32-arm64": "2.5.1",
    "@parcel/watcher-win32-x64": "2.5.1"
  },
  "description": "Koma desktop Agent workbench"
}
