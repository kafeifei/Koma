{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["vite/client", "bun"],
    "paths": { "@/*": ["../app/src/*"] }
  },
  "include": ["src", "scripts", "vite.config.ts", "../app/src/env.d.ts"]
}
