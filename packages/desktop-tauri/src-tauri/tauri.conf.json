{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Koma Tauri Debug",
  "version": "0.1.0",
  "identifier": "ai.opencode.lab.tauri-test",
  "build": {
    "beforeDevCommand": "bun run dev:ui",
    "beforeBuildCommand": "bun run build:ui",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Koma Tauri Debug",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "dragDropEnabled": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 14, "y": 14 },
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' data: ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; worker-src 'self' blob:; media-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["../../desktop/icons/koma/128x128.png", "../../desktop/icons/koma/icon.icns"],
    "externalBin": ["binaries/koma"],
    "resources": ["binaries/build-info.json"],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
